      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "approval-validation-result",
              "name": "result",
              "type": "object",
              "value": "={{ (() => {\n  const rawBody = $('Receive Approval Webhook').item.json.body;\n  const UUID_REGEX = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n  const REQUIRED_SCHEMA = {\n    type: 'object',\n    required: ['inquiry_id', 'email_message_id', 'action', 'approved_by'],\n    properties: {\n      inquiry_id: { type: 'string', format: 'uuid' },\n      email_message_id: { type: 'string', format: 'uuid' },\n      action: { type: 'string', enum: ['approve', 'reject'] },\n      approved_by: { type: 'string', format: 'uuid' },\n      subject: { type: ['string', 'null'], maxLength: 250 },\n      body: { type: ['string', 'null'], maxLength: 10000 },\n      rejection_reason: { type: ['string', 'null'], maxLength: 1000 }\n    }\n  };\n  if (!rawBody || typeof rawBody !== 'object' || Array.isArray(rawBody)) {\n    return {\n      valid: false,\n      validationError: 'Request body must be a JSON object',\n      details: [{ field: 'body', message: 'Request body must be a JSON object' }],\n      requiredSchema: REQUIRED_SCHEMA,\n      normalized: null\n    };\n  }\n  const errors = [];\n  const addError = (field, message) => errors.push({ field, message });\n  const trimOrNull = (val) => {\n    if (typeof val !== 'string') return null;\n    const t = val.trim();\n    return t.length > 0 ? t : null;\n  };\n  const inquiryId = trimOrNull(rawBody.inquiry_id);\n  if (!inquiryId || !UUID_REGEX.test(inquiryId)) addError('inquiry_id', 'inquiry_id must be a valid UUID');\n  const emailMessageId = trimOrNull(rawBody.email_message_id);\n  if (!emailMessageId || !UUID_REGEX.test(emailMessageId)) addError('email_message_id', 'email_message_id must be a valid UUID');\n  const action = trimOrNull(rawBody.action);\n  if (action !== 'approve' && action !== 'reject') addError('action', 'action must be approve or reject');\n  const approvedBy = trimOrNull(rawBody.approved_by);\n  if (!approvedBy || !UUID_REGEX.test(approvedBy)) addError('approved_by', 'approved_by must be a valid UUID');\n  let subject = null;\n  if (rawBody.subject !== undefined && rawBody.subject !== null) {\n    if (typeof rawBody.subject !== 'string') addError('subject', 'subject must be a string');\n    else {\n      const t = rawBody.subject.trim();\n      if (t.length > 250) addError('subject', 'subject must be at most 250 characters');\n      else if (t.length > 0) subject = t;\n    }\n  }\n  let bodyText = null;\n  if (rawBody.body !== undefined && rawBody.body !== null) {\n    if (typeof rawBody.body !== 'string') addError('body', 'body must be a string');\n    else {\n      const t = rawBody.body.trim();\n      if (t.length > 10000) addError('body', 'body must be at most 10000 characters');\n      else if (t.length > 0) bodyText = t;\n    }\n  }\n  let rejectionReason = null;\n  if (rawBody.rejection_reason !== undefined && rawBody.rejection_reason !== null) {\n    if (typeof rawBody.rejection_reason !== 'string') addError('rejection_reason', 'rejection_reason must be a string');\n    else {\n      const t = rawBody.rejection_reason.trim();\n      if (t.length > 1000) addError('rejection_reason', 'rejection_reason must be at most 1000 characters');\n      else if (t.length > 0) rejectionReason = t;\n    }\n  }\n  if (errors.length > 0) {\n    return {\n      valid: false,\n      validationError: errors[0].message,\n      details: errors,\n      requiredSchema: REQUIRED_SCHEMA,\n      normalized: null\n    };\n  }\n  return {\n    valid: true,\n    validationError: null,\n    details: [],\n    requiredSchema: null,\n    normalized: {\n      inquiry_id: inquiryId,\n      email_message_id: emailMessageId,\n      action,\n      approved_by: approvedBy,\n      subject,\n      body: bodyText,\n      rejection_reason: rejectionReason,\n      expected_idempotency_key: 'email:' + inquiryId + ':initial',\n      received_at: DateTime.now().toUTC().toISO()\n    }\n  };\n})() }}"
            }
          ]
        },
        "options": {}
      },
      "notes": "Defense-in-depth WF02 request validator matching 03-api-and-rls-contract.md."
