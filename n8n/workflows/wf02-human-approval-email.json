    {
      "id": "2ec45b4b-c824-4255-8c88-11fec4c5619f",
      "name": "Evaluate Approval Guards",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1248,
        320
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "approval-guard-result",
              "name": "guard",
              "type": "object",
              "value": "={{ (() => {\n  const req = $('Validate Approval Payload').item.json.result.normalized;\n  const inquiry = $('Fetch Inquiry Record').item.json || {};\n  const email = $('Fetch Email Draft').item.json || {};\n  const fail = (httpStatus, errorCode, message) => ({\n    allowed: false,\n    httpStatus,\n    errorCode,\n    message,\n    action: req.action,\n    currentApprovalStatus: inquiry.approval_status ?? null,\n    currentEmailStatus: email.status ?? null\n  });\n  if (!inquiry.id) return fail(404, 'NOT_FOUND', 'Inquiry not found');\n  if (!email.id) return fail(404, 'NOT_FOUND', 'Operational email draft not found');\n  if (email.inquiry_id !== inquiry.id) return fail(409, 'CONFLICT', 'Email draft does not belong to the specified inquiry');\n  if (email.message_type !== 'initial' || email.direction !== 'outbound') return fail(409, 'CONFLICT', 'Only outbound initial email drafts can be processed by WF02');\n  if (email.idempotency_key !== req.expected_idempotency_key) return fail(409, 'CONFLICT', 'Email draft idempotency_key does not match expected initial email key');\n  if (email.status === 'sent' || email.provider_message_id) return fail(409, 'CONFLICT', 'Initial email has already been sent for this inquiry');\n  if (inquiry.approval_status !== 'pending') return fail(409, 'CONFLICT', 'Inquiry cannot be processed while approval_status is ' + inquiry.approval_status);\n  if (email.status !== 'pending_approval') return fail(409, 'CONFLICT', 'Email draft cannot be processed while status is ' + email.status);\n  if (req.action === 'approve' && Boolean(inquiry.unsubscribed_at)) return fail(409, 'CONFLICT', 'Cannot send outbound email to an unsubscribed inquiry');\n  const finalSubject = req.subject || (typeof email.subject === 'string' && email.subject.trim() ? email.subject.trim() : 'Following up on your project inquiry with Veloce Digital');\n  const finalBody = req.body || (typeof email.body === 'string' ? email.body.trim() : '');\n  if (req.action === 'approve' && !finalBody) return fail(400, 'VALIDATION_ERROR', 'Email body cannot be empty');\n  const recipientEmail = typeof email.recipient_email === 'string' ? email.recipient_email.trim().toLowerCase() : '';\n  if (req.action === 'approve' && !recipientEmail) return fail(400, 'VALIDATION_ERROR', 'Recipient email address is missing on draft');\n  const nextFollowupStatus = inquiry.consent_to_email === true && !inquiry.unsubscribed_at ? 'scheduled' : 'not_eligible';\n  return {\n    allowed: true,\n    httpStatus: 200,\n    errorCode: null,\n    message: null,\n    action: req.action,\n    finalSubject,\n    finalBody,\n    recipientEmail,\n    idempotencyKey: email.idempotency_key,\n    nextFollowupStatus,\n    actionTimestamp: DateTime.now().toUTC().toISO(),\n    currentApprovalStatus: inquiry.approval_status,\n    currentEmailStatus: email.status\n  };\n})() }}"
            }
          ]
        },
        "options": {}
      },
      "notes": "Enforces strict HITL pending state, ownership, idempotency_key invariant, and unsubscribe protection before side effects."
    },
