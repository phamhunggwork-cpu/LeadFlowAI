{
  "name": "WF03 - Automated Follow-up",
  "description": "Hourly schedule that sends one deterministic follow-up 24h+ after a delivered initial email, and stops the sequence on unsubscribe, reply, closed, won, or missing consent.",
  "nodes": [
    {
      "id": "6e49ddcd-9b36-4d2f-8b62-41e1509f3574",
      "typeVersion": 1.4,
      "name": "Hourly Follow-up Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        0,
        304
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1,
              "triggerAtMinute": 5
            }
          ]
        }
      },
      "notes": "Runs hourly at :05. Eligibility (24h+ after delivered initial email) is evaluated deterministically downstream."
    },
    {
      "id": "8f669344-3871-434a-8bc2-79e525d7d265",
      "typeVersion": 1,
      "name": "Fetch Scheduled Inquiries",
      "type": "n8n-nodes-base.supabase",
      "position": [
        224,
        304
      ],
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "inquiries",
        "returnAll": true,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "followup_status",
              "condition": "eq",
              "keyValue": "scheduled"
            }
          ]
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_WITH_SUPABASE_CREDENTIAL_ID",
          "name": "Supabase LeadFlow"
        }
      },
      "notes": "Loads every inquiry still in followup_status=scheduled. Stop rules (unsubscribed, replied, closed, won, no consent) are applied in the eligibility node so those leads can be moved to stopped.",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "alwaysOutputData": true
    },
    {
      "id": "b2ed5e50-72ef-4732-8785-4c4c1e47ae7f",
      "typeVersion": 1,
      "name": "Fetch Initial Emails",
      "type": "n8n-nodes-base.supabase",
      "position": [
        448,
        304
      ],
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "email_messages",
        "returnAll": true,
        "filterType": "string",
        "filterString": "={{ 'inquiry_id=in.(' + ($('Fetch Scheduled Inquiries').all().map((i) => i.json.id).filter((v) => /^[0-9a-f-]{36}$/i.test(v || '')).join(',') || '00000000-0000-0000-0000-000000000000') + ')&message_type=eq.initial&status=eq.sent' }}"
      },
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_WITH_SUPABASE_CREDENTIAL_ID",
          "name": "Supabase LeadFlow"
        }
      },
      "notes": "Delivered initial emails for the scheduled inquiries (sent_at drives the 24h window; recipient_email is reused).",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "id": "5ae7a5e9-a05e-4fdf-bfba-19ba77bbc031",
      "typeVersion": 1,
      "name": "Fetch Existing Follow-ups",
      "type": "n8n-nodes-base.supabase",
      "position": [
