        "operation": "getAll",
        "tableId": "email_messages",
        "returnAll": true,
        "filterType": "string",
        "filterString": "={{ 'inquiry_id=in.(' + ($('Fetch Scheduled Inquiries').all().map((i) => i.json.id).filter((v) => /^[0-9a-f-]{36}$/i.test(v || '')).join(',') || '00000000-0000-0000-0000-000000000000') + ')&message_type=eq.follow_up' }}"
      },
      "credentials": {
