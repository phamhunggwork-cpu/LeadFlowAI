      },
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_WITH_SUPABASE_CREDENTIAL_ID",
          "name": "Supabase LeadFlow"
        }
      },
      "notes": "Contact names for first-name personalization only.",
