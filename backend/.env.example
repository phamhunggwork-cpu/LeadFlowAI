# LeadFlow AI — Backend API Gateway Environment Template
# Copy to `backend/.env` (never commit real secrets)

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase (DEV project — service_role key stays strictly server-side)
SUPABASE_URL=https://your-dev-project-ref.supabase.co
SUPABASE_ANON_KEY=replace_with_dev_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_dev_service_role_key

# n8n Webhook Proxy Authentication
N8N_WEBHOOK_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=replace_with_shared_webhook_secret
N8N_WF01_PATH=/webhook/lead-intake
N8N_WF02_PATH=/webhook/lead-approval

# Optional: Direct DeepSeek / Resend keys if invoked from Node scripts or validators (ADR-007)
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
RESEND_API_KEY=replace_with_resend_api_key
