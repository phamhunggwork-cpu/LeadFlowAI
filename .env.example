# LeadFlow AI — Root Environment Template (Local Dev, n8n Sync & Vitest)
# Copy to `.env` (never commit real `.env` files)

# Local n8n Public REST API (used by n8n/scripts/sync-workflows.ts)
N8N_API_BASE_URL=http://localhost:5678/api/v1
N8N_API_KEY=replace_with_local_n8n_api_key

# Local n8n Webhooks (used by Backend & Vitest integration tests)
N8N_WEBHOOK_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=replace_with_shared_webhook_secret

# Dedicated Supabase TEST Environment (used ONLY by Vitest integration suite — NEVER production)
TEST_API_BASE_URL=http://localhost:4000
TEST_SUPABASE_URL=https://your-test-project-ref.supabase.co
TEST_SUPABASE_ANON_KEY=replace_with_test_anon_key
TEST_SUPABASE_SERVICE_ROLE_KEY=replace_with_test_service_role_key
TEST_USER_EMAIL=qa-rep@velocedigital.test
TEST_USER_PASSWORD=replace_with_test_user_password

# Vitest Async Polling Configuration
TEST_POLL_TIMEOUT_MS=20000
TEST_POLL_INTERVAL_MS=1000
TEST_RUN_PREFIX=vitest_leadflow_
